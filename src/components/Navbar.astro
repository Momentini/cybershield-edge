---
// src/components/Navbar.astro
interface Props {
  showLinks?: boolean;
}

const { showLinks = true } = Astro.props;
---

<header class="fixed top-0 left-0 w-full z-50 backdrop-blur-md bg-white/70 dark:bg-slate-950/70 border-b border-slate-200/80 dark:border-slate-800/80 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
     
      <!-- Brand Logo -->
      <a href="#" class="flex items-center gap-2 text-lg font-bold text-cyan-600 dark:text-cyan-400">
        <span class="p-1.5 bg-cyan-100 dark:bg-cyan-950/80 rounded border border-cyan-300 dark:border-cyan-500/30 text-base">🛡️</span>
        CyberShield<span class="text-slate-900 dark:text-slate-100">Edge</span>
      </a>

      <!-- Link Navigazione Desktop (Mostrato solo se showLinks è true) -->
      {showLinks && (
        <nav class="hidden md:flex items-center gap-8 text-xs font-mono uppercase tracking-wider text-slate-600 dark:text-slate-300">
          <a href="#soluzioni" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Soluzioni</a>
          <a href="#architettura" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Architettura</a>
          <a href="#compliance" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Compliance</a>
        </nav>
      )}

      <!-- Azioni: Theme Toggle + CTA -->
      <div class="flex items-center gap-3">
       
        <!-- Toggle Tema (Dark / Light) -->
        <button
          id="theme-toggle"
          aria-label="Cambia Tema"
          class="p-2 rounded-lg bg-slate-200/80 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:text-cyan-500 transition-colors"
        >
          <!-- Icona Luna (visibile in Light mode) -->
          <svg id="theme-toggle-dark-icon" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
          <!-- Icona Sole (visibile in Dark mode) -->
          <svg id="theme-toggle-light-icon" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.707.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1z" fill-rule="evenodd" clip-rule="evenodd"></path>
          </svg>
        </button>

        <!-- Link Navigazione Desktop (Mostrato solo se showLinks è true) -->
        {showLinks && (
          <a
            href="#demo"
            class="hidden sm:inline-flex px-4 py-2 text-xs font-semibold rounded-lg text-white bg-cyan-600 hover:bg-cyan-500 dark:bg-cyan-500 dark:hover:bg-cyan-400 dark:text-slate-950 transition-all shadow-sm"
          >
            Prenota una Demo
          </a>
        )}
        
      </div>
      
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const darkIcon = document.getElementById('theme-toggle-dark-icon');
    const lightIcon = document.getElementById('theme-toggle-light-icon');
    const themeToggleBtn = document.getElementById('theme-toggle');

    // Imposta le icone in base allo stato attuale
    if (document.documentElement.classList.contains('dark')) {
      lightIcon?.classList.remove('hidden');
    } else {
      darkIcon?.classList.remove('hidden');
    }

    themeToggleBtn?.addEventListener('click', () => {
      // Toggle icone
      darkIcon?.classList.toggle('hidden');
      lightIcon?.classList.toggle('hidden');

      // Toggle della classe 'dark' sul tag html e salvataggio preferenza
      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  });
</script>


