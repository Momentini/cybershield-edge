---
// src/components/Footer.astro
interface Props {
  showLinks?: boolean;
}

const { showLinks = true } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-white dark:bg-slate-950 border-t border-slate-200 dark:border-slate-900 text-slate-600 dark:text-slate-400 text-xs py-12 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-8 border-b border-slate-200 dark:border-slate-900">
     
      <!-- Brand & Description (adatta la larghezza se non ci sono i link) -->
      <div class={showLinks ? "md:col-span-5 flex flex-col items-start" : "md:col-span-7 flex flex-col items-start"}>
        <a href="#" class="flex items-center gap-2 text-lg font-bold text-cyan-600 dark:text-cyan-400 mb-3">
          <span class="p-1 bg-cyan-100 dark:bg-cyan-950/80 rounded border border-cyan-300 dark:border-cyan-500/30 text-sm">🛡️</span>
          CyberShield<span class="text-slate-900 dark:text-slate-100">Edge</span>
        </a>
        <p class="text-slate-600 dark:text-slate-500 leading-relaxed max-w-sm mb-4">
          Piattaforma B2B di sicurezza informatica Zero-Trust orientata a infrastrutture Edge Computing, nodi IoT industriali e reti distribuite.
        </p>
        <div class="font-mono text-[11px] text-slate-500 dark:text-slate-600">
          Statale di Milano — Computer Security Portfolio Project
        </div>
      </div>

      <!-- Quick Links (3 colonne) - Mostrato solo se showLinks è true -->
      {showLinks && (
        <div class="md:col-span-3">
          <h3 class="text-slate-900 dark:text-slate-200 font-semibold mb-3 uppercase tracking-wider font-mono text-[11px]">Navigazione</h3>
          <ul class="space-y-2">
            <li><a href="#soluzioni" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Soluzioni &amp; Features</a></li>
            <li><a href="#architettura" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Zero-Trust Architecture</a></li>
            <li><a href="#compliance" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Compliance &amp; NIS 2</a></li>
            <li><a href="#demo" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Richiedi Demo PoC</a></li>
          </ul>
        </div>
      )}

      <!-- Compliance & Certificazioni (adatta la larghezza se non ci sono i link) -->
      <div class={showLinks ? "md:col-span-4" : "md:col-span-5"}>
        <h3 class="text-slate-900 dark:text-slate-200 font-semibold mb-3 uppercase tracking-wider font-mono text-[11px]">Standard di Sicurezza</h3>
        <div class="flex flex-wrap gap-2 text-[11px] font-mono">
          <span class="px-2 py-1 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded text-slate-700 dark:text-slate-400">ISO/IEC 27001</span>
          <span class="px-2 py-1 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded text-slate-700 dark:text-slate-400">SOC 2 Type II</span>
          <span class="px-2 py-1 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded text-slate-700 dark:text-slate-400">EU NIS 2</span>
          <span class="px-2 py-1 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded text-slate-700 dark:text-slate-400">GDPR Compliant</span>
        </div>
      </div>

    </div>

    <!-- Copyright / Bottom Bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-500 dark:text-slate-600">
      <p>© {currentYear} CyberShield Edge. Progetto dimostrativo ad uso portfolio.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-slate-900 dark:hover:text-slate-400 transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-slate-900 dark:hover:text-slate-400 transition-colors">Cookie Policy</a>
        <a href="#" class="hover:text-slate-900 dark:hover:text-slate-400 transition-colors">Security Disclosure</a>
      </div>
    </div>
  </div>
</footer>
