---
// src/components/Contact.astro
---

<section id="demo" class="py-20 relative bg-slate-100/80 dark:bg-slate-950 transition-colors duration-300 overflow-hidden">
  <!-- Glow di sfondo -->
  <div class="absolute bottom-0 right-1/4 w-[500px] h-[250px] bg-cyan-500/10 blur-[140px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Testi e Info Contatto (5 Colonne) -->
      <div class="lg:col-span-5 flex flex-col items-start">
        <span class="text-xs font-semibold text-cyan-600 dark:text-cyan-400 tracking-widest uppercase mb-3 font-mono">
          // Richiedi Accesso
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-6">
          Pronto a proteggere la tua rete Edge?
        </h2>
        <p class="text-slate-600 dark:text-slate-400 text-base leading-relaxed mb-8">
          Prenota una sessione tecnica individuale con i nostri Security Engineer. Valuteremo l'architettura della tua rete e configureremo un ambiente PoC (Proof of Concept) dedicato.
        </p>

        <!-- Punti Chiave -->
        <div class="space-y-4 text-sm text-slate-700 dark:text-slate-300">
          <div class="flex items-center gap-3">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-cyan-100 dark:bg-cyan-950 border border-cyan-300 dark:border-cyan-500/40 flex items-center justify-center text-cyan-700 dark:text-cyan-400 text-xs font-bold">✓</span>
            <span>Setup Sandbox PoC in meno di 24 ore</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-cyan-100 dark:bg-cyan-950 border border-cyan-300 dark:border-cyan-500/40 flex items-center justify-center text-cyan-700 dark:text-cyan-400 text-xs font-bold">✓</span>
            <span>Nessun agente pesante o riavvio dell'infrastruttura</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-cyan-100 dark:bg-cyan-950 border border-cyan-300 dark:border-cyan-500/40 flex items-center justify-center text-cyan-700 dark:text-cyan-400 text-xs font-bold">✓</span>
            <span>Supporto diretto da Ingegneri di Rete e Security Analyst</span>
          </div>
        </div>
      </div>

      <!-- Form Interattivo (7 Colonne) -->
      <div class="lg:col-span-7">
        <div class="bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 shadow-md dark:shadow-2xl transition-colors duration-300">
          
          <form id="demo-form" class="space-y-5" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              
              <!-- Nome -->
              <div>
                <label for="fullName" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5 font-mono">Nome e Cognome *</label>
                <input 
                  type="text" 
                  id="fullName" 
                  name="fullName" 
                  placeholder="Mario Rossi"
                  class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-600 focus:outline-none focus:border-cyan-500 transition-colors"
                  required
                />
                <span class="error-msg text-[11px] text-rose-600 dark:text-rose-400 hidden mt-1">Inserisci il tuo nome completo.</span>
              </div>

              <!-- Email Aziendale -->
              <div>
                <label for="businessEmail" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5 font-mono">Email Aziendale *</label>
                <input 
                  type="email" 
                  id="businessEmail" 
                  name="businessEmail" 
                  placeholder="mario.rossi@azienda.com"
                  class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-600 focus:outline-none focus:border-cyan-500 transition-colors"
                  required
                />
                <span class="error-msg text-[11px] text-rose-600 dark:text-rose-400 hidden mt-1">Inserisci un indirizzo email aziendale valido.</span>
              </div>

            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              
              <!-- Nome Azienda -->
              <div>
                <label for="company" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5 font-mono">Azienda *</label>
                <input 
                  type="text" 
                  id="company" 
                  name="company" 
                  placeholder="Acme Corp S.p.A."
                  class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-600 focus:outline-none focus:border-cyan-500 transition-colors"
                  required
                />
                <span class="error-msg text-[11px] text-rose-600 dark:text-rose-400 hidden mt-1">Inserisci la tua azienda.</span>
              </div>

              <!-- Tipo Infrastruttura -->
              <div>
                <label for="infraType" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5 font-mono">Tipo di Infrastruttura</label>
                <select 
                  id="infraType" 
                  name="infraType"
                  class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:border-cyan-500 transition-colors"
                >
                  <option value="iot-industrial" class="bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100">IoT Industriale / OT Network</option>
                  <option value="edge-nodes" class="bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100">Server Edge Distribuiti</option>
                  <option value="hybrid-cloud" class="bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100">Multi-Cloud / Hybrid Infrastructure</option>
                  <option value="other" class="bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100">Altro / Non specificato</option>
                </select>
              </div>

            </div>

            <!-- Messaggio -->
            <div>
              <label for="message" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5 font-mono">Dettagli del Progetto / Note</label>
              <textarea 
                id="message" 
                name="message" 
                rows="3" 
                placeholder="Descrivi brevemente il numero di nodi o le tue esigenze di compliance..."
                class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-600 focus:outline-none focus:border-cyan-500 transition-colors resize-none"
              ></textarea>
            </div>

            <!-- Bottone Submit -->
            <button 
              type="submit" 
              id="submit-btn"
              class="w-full py-3 px-6 text-sm font-semibold text-white bg-cyan-600 hover:bg-cyan-500 dark:bg-cyan-400 dark:hover:bg-cyan-300 dark:text-slate-950 rounded-lg transition-all shadow-[0_0_20px_rgba(34,211,238,0.25)] flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Invia Richiesta Demo</span>
            </button>

            <!-- Box di Successo -->
            <div id="success-message" class="hidden p-4 rounded-lg bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-300 dark:border-emerald-500/40 text-emerald-800 dark:text-emerald-300 text-xs font-mono text-center">
              ✓ Richiesta presa in carico! Un nostro Security Engineer ti contatterà entro 2 ore lavorative.
            </div>

          </form>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- Script Client-Side in TypeScript -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('demo-form') as HTMLFormElement | null;
    const successBox = document.getElementById('success-message');
    const submitBtn = document.getElementById('submit-btn');

    if (!form) return;

    form.addEventListener('submit', (e: SubmitEvent) => {
      e.preventDefault();
      let isValid = true;

      const emailInput = document.getElementById('businessEmail') as HTMLInputElement;
      const nameInput = document.getElementById('fullName') as HTMLInputElement;
      const companyInput = document.getElementById('company') as HTMLInputElement;

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      // Reset errori
      document.querySelectorAll('.error-msg').forEach((el) => el.classList.add('hidden'));

      // Validazione Email
      if (!emailInput || !emailRegex.test(emailInput.value.trim())) {
        emailInput?.nextElementSibling?.classList.remove('hidden');
        isValid = false;
      }

      // Validazione Nome
      if (!nameInput || nameInput.value.trim().length < 2) {
        nameInput?.nextElementSibling?.classList.remove('hidden');
        isValid = false;
      }

      // Validazione Azienda
      if (!companyInput || companyInput.value.trim().length < 1) {
        companyInput?.nextElementSibling?.classList.remove('hidden');
        isValid = false;
      }

      // Se la validazione passa
      if (isValid && successBox && submitBtn) {
        submitBtn.classList.add('opacity-50', 'pointer-events-none');
        
        setTimeout(() => {
          form.reset();
          submitBtn.classList.add('hidden');
          successBox.classList.remove('hidden');
        }, 600);
      }
    });
  });
</script>


