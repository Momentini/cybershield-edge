---
// src/components/Hero.astro
---

<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden bg-slate-50 dark:bg-slate-950 transition-colors duration-300">
  
  <!-- Glow di Sfondo -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-cyan-500/10 blur-[120px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Colonna Sinistra: Testi e CTA (7 Colonne) -->
      <div class="lg:col-span-7 flex flex-col items-start">
        
        <!-- Badge di Stato -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyan-50 dark:bg-cyan-950/80 border border-cyan-200 dark:border-cyan-500/30 text-cyan-700 dark:text-cyan-400 text-xs font-mono mb-6">
          <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
          <span>Infrastruttura Zero-Trust di Nuova Generazione</span>
        </div>

        <!-- Titolo Principale -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.15] mb-6">
          Sicurezza eBPF in tempo reale per l'<span class="text-cyan-600 dark:text-cyan-400">Edge Computing</span>
        </h1>

        <!-- Descrizione -->
        <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg leading-relaxed mb-8 max-w-2xl">
          Proteggi i tuoi nodi industriali e le architetture IoT distribuite con isolamento kernel-level, micro-segmentazione dinamica e crittografia Post-Quantum.
        </p>

        <!-- Bottoni Action -->
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
          <a 
            href="#demo" 
            class="px-6 py-3 rounded-lg text-white font-semibold text-sm bg-cyan-600 hover:bg-cyan-500 dark:bg-cyan-400 dark:hover:bg-cyan-300 dark:text-slate-950 transition-all shadow-[0_0_20px_rgba(34,211,238,0.25)] flex items-center justify-center gap-2"
          >
            <span>Richiedi una Demo PoC</span>
            <span>→</span>
          </a>

          <a 
            href={`${import.meta.env.BASE_URL}docs/scheda-tecnica-cybershield.pdf`}
            download="Scheda_Tecnica_CyberShield_Edge.pdf"
            class="px-6 py-3 rounded-lg border border-slate-300 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:border-slate-400 dark:hover:border-slate-600 bg-white dark:bg-slate-900/50 font-semibold text-sm transition-all flex items-center justify-center gap-2 shadow-sm dark:shadow-none"
          >
            <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            Scheda Tecnica (PDF)
          </a>
        </div>

      </div>

      <!-- Colonna Destra: Terminal Log (5 Colonne) -->
      <div class="lg:col-span-5 w-full">
        <div class="rounded-2xl bg-slate-900 border border-slate-800 p-6 shadow-2xl font-mono text-xs text-slate-300 relative overflow-hidden">
          
          <!-- Bar dei controlli -->
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-800 text-slate-500">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
            </div>
            <span class="text-[11px] text-slate-400">ebpf-daemon // node-01</span>
          </div>

          <!-- Console Output Simulated -->
          <div class="space-y-2.5 leading-relaxed">
            <p class="text-slate-500">[19:42:01] <span class="text-cyan-400">INFO</span> Initializing eBPF probe on eth0...</p>
            <p class="text-slate-500">[19:42:02] <span class="text-emerald-400">SUCCESS</span> Policy loaded: Zero-Trust Strict</p>
            <p class="text-slate-500">[19:42:05] <span class="text-amber-400">WARN</span> Anomaly detected: TCP SYN Flood [192.168.1.104]</p>
            <div class="p-2.5 rounded bg-slate-950 border border-slate-800 my-2">
              <p class="text-rose-400 font-bold">BLOCK ACTION EXECUTED</p>
              <p class="text-slate-400 text-[11px]">Rule #402: Drop packet at XDP layer (0.02ms)</p>
            </div>
            <p class="text-slate-500">[19:42:06] <span class="text-cyan-400">INFO</span> System health: 100% | Latency: 0.12ms</p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
