---
// src/components/Features.astro
const features = [
  {
    id: "architettura",
    title: "Micro-segmentazione Zero-Trust",
    description: "Isolamento dinamico dei flussi di rete a livello di singolo nodo Edge per prevenire lo spostamento laterale delle minacce.",
    badge: "Architettura Rete",
    colSpan: "lg:col-span-8",
  },
  {
    id: "ebpf",
    title: "Ispezione Kernel-Level eBPF",
    description: "Analisi dei pacchetti in tempo reale senza overhead di sistema.",
    badge: "Performance",
    colSpan: "lg:col-span-4",
  },
  {
    id: "pqc",
    title: "Crittografia Post-Quantum",
    description: "Algoritmi di cifratura resilienti alle future minacce quantistiche.",
    badge: "Crypto-Agility",
    colSpan: "lg:col-span-4",
  },
  {
    id: "compliance",
    title: "Compliance NIS 2 & ISO 27001",
    description: "Reportistica automatizzata e audit trail crittografici conformi alle normative europee sulla sicurezza delle infrastrutture critiche.",
    badge: "Governance",
    colSpan: "lg:col-span-8",
  }
];
---

<section id="soluzioni" class="scroll-mt-24 py-24 bg-slate-100/80 dark:bg-slate-950 relative overflow-hidden transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
   
    <!-- Header Sezione -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-semibold text-cyan-600 dark:text-cyan-400 tracking-widest uppercase mb-3 block font-mono">
        // ARCHITETTURA & SOLUZIONI
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
        Sicurezza multilivello progettata per l'Edge Industriale
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base leading-relaxed">
        Garantisci l'integrità dei nodi distribuiti senza sacrificare le prestazioni di rete o introdurre latenza.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      {features.map((item) => (
        <div
          id={item.id}
          class={`${item.colSpan} scroll-mt-28 group relative rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800/80 p-8 shadow-sm dark:shadow-none hover:border-cyan-500/50 transition-all duration-300 flex flex-col justify-between`}
        >
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="px-2.5 py-1 text-[11px] font-mono rounded-md bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">
                {item.badge}
              </span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
              {item.title}
            </h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-6">
              {item.description}
            </p>
          </div>

          <!-- LINK CORRETTO CON BASE_URL PER EVITARE I 404 -->
          <div class="pt-4 border-t border-slate-100 dark:border-slate-800/50">
            <a
              href={`${import.meta.env.BASE_URL}moduli/${item.id}`}
              class="inline-flex items-center text-xs font-mono text-cyan-600 dark:text-cyan-400 hover:text-cyan-500 dark:hover:text-cyan-300 font-medium transition-colors"
            >
              <span>Esplora modulo</span>
              <span class="ml-2 group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>