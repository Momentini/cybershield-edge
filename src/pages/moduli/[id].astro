---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const modules = [
    {
      id: 'architettura',
      badge: 'Architettura Rete',
      title: 'Micro-segmentazione Zero-Trust',
      subtitle: 'Isolamento granulare dei flussi di rete a livello di singolo container e gateway Edge.',
      overview: 'La micro-segmentazione Zero-Trust per ambienti Edge & IoT applica regole di filtro a livello di interfaccia di rete virtuale. Ogni nodo viene trattato come una zona isolata untrusted.',
      specs: [
        { label: 'Modello di Sicurezza', value: 'Default Deny (Zero Trust Network Access)' },
        { label: 'Isolamento Traffic', value: 'VLAN / VXLAN con eBPF filtering' },
        { label: 'Latenza di Regola', value: '< 0.05 ms per pacchetto' },
        { label: 'Protocolli Supportati', value: 'MQTT, CoAP, OPC-UA, Modbus TCP, HTTP/2' }
      ],
      technicalDetails: 'Attraverso l’impiego di eBPF nel kernel Linux dei gateway Edge, il traffico non autorizzato viene bloccato direttamente nello stack di rete primario (XDP - eXpress Data Path) prima di consumare risorse CPU nello user-space.'
    },
    {
      id: 'ebpf',
      badge: 'Performance & Observability',
      title: 'Ispezione Kernel-Level eBPF',
      subtitle: 'Analisi dei pacchetti in tempo reale senza overhead e senza modificare il codice del kernel.',
      overview: 'eBPF (Extended Berkeley Packet Filter) consente di eseguire bytecode in modo sicuro all’interno del kernel Linux, fornendo una visibilità profonda a livello di pacchetto e system call.',
      specs: [
        { label: 'Layer di Esecuzione', value: 'Linux Kernel Space (XDP / TC hook)' },
        { label: 'Overhead CPU', value: '< 1.5% a pieno carico' },
        { label: 'Telemetria', value: 'Metrics Prometheus native & OpenTelemetry' },
        { label: 'Threat Detection', value: 'In-line packet inspection senza context-switch' }
      ],
      technicalDetails: 'I programmi eBPF caricati da CyberShield Edge monitorano le syscall e le interfacce di rete in tempo reale, rilevando attacchi DDoS e anomalie di comportamento nei processi IoT.'
    },
    {
      id: 'pqc',
      badge: 'Crypto-Agility',
      title: 'Crittografia Post-Quantum',
      subtitle: 'Algoritmi di cifratura avanzati e resilienti alle minacce di calcolo quantistico.',
      overview: 'CyberShield Edge integra algoritmi di crittografia post-quantistica standardizzati dal NIST per proteggere i canali di comunicazione tra nodi Edge e cloud centralizzato.',
      specs: [
        { label: 'Algoritmi KEM', value: 'CRYSTALS-Kyber (FIPS 203)' },
        { label: 'Firme Digitali', value: 'CRYSTALS-Dilithium (FIPS 204)' },
        { label: 'Key Exchange', value: 'Hybrid ECDH + Post-Quantum KEM' },
        { label: 'Standard Compliance', value: 'NIST PQC Standardization Phase 4' }
      ],
      technicalDetails: 'La nostra architettura garantisce il principio di Forward Secrecy quantistica, proteggendo la riservatezza dei dati anche di fronte a scenari "Harvest Now, Decrypt Later".'
    },
    {
      id: 'compliance',
      badge: 'Governance & Audit',
      title: 'Compliance NIS 2 & ISO 27001',
      subtitle: 'Reportistica automatizzata e audit trail crittografici conformi alle normative europee.',
      overview: 'Semplifica l’adeguamento alla direttiva europea NIS 2 (Network and Information Security) e agli standard ISO/IEC 27001 con log immutabili ed esportabili.',
      specs: [
        { label: 'Direttiva EU', value: 'NIS 2 (EU 2022/2555) Compliant' },
        { label: 'Audit Trail', value: 'Registro log firmato con marca temporale' },
        { label: 'Incident Reporting', value: 'Notifica automatizzata entro 24 ore' },
        { label: 'Standard Framework', value: 'ISO/IEC 27001, NIST CSF 2.0' }
      ],
      technicalDetails: 'Tutte le modifiche alle policy di sicurezza e le rilevazioni di minacce vengono memorizzate su una struttura ad albero di Merkle per garantire l’immutabilità legale dei log.'
    }
  ];

  return modules.map((mod) => ({
    params: { id: mod.id },
    props: { module: mod }
  }));
}

const { module } = Astro.props;
---

<Layout title={`${module.title} | CyberShield Edge`}>
  <Navbar showLinks={false} />

  <main class="pt-32 pb-24 bg-slate-50 dark:bg-slate-950 transition-colors duration-300 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-12">
      
      <!-- Back Link corretto verso la sezione della Home -->
      <div>
        <a
          href={`${import.meta.env.BASE_URL}#soluzioni`}
          class="inline-flex items-center gap-2 text-xs font-mono text-slate-600 dark:text-slate-400 hover:text-cyan-600 dark:hover:text-cyan-400 mb-6 transition-colors group"
        >
          <span class="group-hover:-translate-x-1 transition-transform">←</span>
          <span>Torna alla Home</span>
        </a>

        <div>
          <span class="inline-block px-3 py-1 text-xs font-mono rounded-md bg-cyan-100 dark:bg-cyan-950 border border-cyan-300 dark:border-cyan-500/30 text-cyan-700 dark:text-cyan-400 mb-4">
            {module.badge}
          </span>
          <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
            {module.title}
          </h1>
          <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
            {module.subtitle}
          </p>
        </div>
      </div>

      <!-- 1. Panoramica -->
      <div class="p-8 sm:p-10 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-sm">
        <h2 class="text-xs font-mono font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-3">// Panoramica Generale</h2>
        <p class="text-slate-800 dark:text-slate-200 text-base leading-relaxed">
          {module.overview}
        </p>
      </div>

      <!-- 2. Specifiche Tecniche Grid -->
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-6">Specifiche Tecniche</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {module.specs.map((spec) => (
            <div class="p-6 rounded-2xl bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/80 shadow-sm">
              <span class="block text-xs font-mono text-slate-500 dark:text-slate-400 mb-2">{spec.label}</span>
              <span class="block text-base font-semibold text-slate-900 dark:text-white">{spec.value}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- 3. Nota Architetturale -->
      <div class="p-8 sm:p-10 rounded-2xl bg-slate-900 border border-slate-800 text-slate-300 font-mono text-sm leading-relaxed shadow-xl">
        <span class="text-cyan-400 block mb-3 font-bold text-xs uppercase tracking-wider">// NOTA ARCHITETTURALE &amp; SICUREZZA</span>
        <p class="text-slate-300 leading-relaxed">{module.technicalDetails}</p>
      </div>

      <!-- 4. CTA Box corretto con BASE_URL -->
      <div class="p-8 sm:p-10 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-md">
        <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-2">
          Vuoi testare questo modulo nel tuo laboratorio?
        </h3>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mb-6">
          Pianifica una sessione di PoC con i nostri Security Engineer.
        </p>

        <a
          href={`${import.meta.env.BASE_URL}#contatti`}
          class="inline-block bg-cyan-600 hover:bg-cyan-500 dark:bg-cyan-500 dark:hover:bg-cyan-400 text-white dark:text-slate-950 font-bold text-sm sm:text-base rounded-xl transition-all shadow-md hover:shadow-cyan-500/20"
          style="display: inline-block; padding: 14px 28px;"
        >
          Richiedi Sandbox PoC →
        </a>
      </div>

    </div>
  </main>

  <Footer showLinks={false} />
</Layout> 